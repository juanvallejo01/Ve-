# Frontend Environment Variables
#
# Expo only inlines env vars prefixed with EXPO_PUBLIC_ into the JS bundle at
# build time (see https://docs.expo.dev/guides/environment-variables/) — the
# web app's NEXT_PUBLIC_ prefix does not apply here.

# API URL
#
# NOTE on local dev hosts — unlike a browser tab, which shares the host
# machine's network namespace, each RN runtime sees "localhost" differently:
#   - iOS Simulator: `localhost` / `127.0.0.1` works directly (it shares the
#     Mac's network namespace). This is the default below.
#   - Android Emulator: `localhost` refers to the emulator's own virtual
#     device, not your host machine. Use `10.0.2.2` instead, e.g.
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:3002/api
#   - Physical device (either OS) on the same Wi-Fi: use your host machine's
#     LAN IP, e.g. EXPO_PUBLIC_API_URL=http://192.168.1.23:3002/api
EXPO_PUBLIC_API_URL=http://localhost:3002/api

# Production example:
# EXPO_PUBLIC_API_URL=https://api.usconnect.com/api
