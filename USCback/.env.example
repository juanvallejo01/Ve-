# Environment
NODE_ENV=development

# Server
PORT=3000

# Pooled (PgBouncer) connection — used by the running app
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=10&pool_timeout=20"
# Direct (unpooled) connection — used only by `prisma migrate`
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# For production, use your frontend domain:
# CORS_ORIGIN=https://usconnect.com
# Or for local development with Next.js default port:
# CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_LIKES_PER_MINUTE=20
RATE_LIMIT_LIKES_PER_DAY=100
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Resend (email transaccional — usado para el código 2FA de login)
RESEND_API_KEY=re_<tu-api-key>

# Stripe (pagos de emprendimientos)
STRIPE_SECRET_KEY=sk_test_<tu-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<tu-webhook-secret>
STRIPE_PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<tu-publishable-key>
