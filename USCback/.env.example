# Environment
NODE_ENV=development

# Server
PORT=3000

# Pooled (PgBouncer) connection — used by the running app
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=10&pool_timeout=20"
# Direct (unpooled) connection — used only by `prisma migrate`
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS (varios orígenes separados por coma; la app móvil no necesita CORS,
# solo navegadores: landing y Expo web)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# For production, use your frontend domain:
# CORS_ORIGIN=https://usconnect.com
# Or for local development with Next.js default port:
# CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_LIKES_PER_MINUTE=20
RATE_LIMIT_LIKES_PER_DAY=100
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# 2FA por correo en login/registro.
#  - Sin definir o =true  -> activo (comportamiento normal, requiere Resend).
#  - =false               -> se omite el 2FA y se abre sesion directo. Solo dev:
#                            si NODE_ENV=production se ignora y el 2FA sigue activo.
#    La logica de OTP (issueTwoFactorCode / verifyOtp) queda intacta en el codigo.
AUTH_2FA_ENABLED=false

# Resend (email transaccional — usado para el código 2FA de login).
# Si AUTH_2FA_ENABLED=false no hace falta. Si el 2FA esta activo y no hay key
# real, en desarrollo el codigo se imprime en la consola del backend en vez
# de enviarse por correo (ver MailService).
RESEND_API_KEY=re_<tu-api-key>

# Stripe (pagos de emprendimientos)
STRIPE_SECRET_KEY=sk_test_<tu-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<tu-webhook-secret>
STRIPE_PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<tu-publishable-key>

# Cuenta de demo para la revisión de App Store / Google Play
# (npm run review:account). Ver docs/PUBLICACION-TIENDAS.md.
# REVIEW_ACCOUNT_EMAIL=revision.app@usc.edu.co
# REVIEW_ACCOUNT_PASSWORD=
